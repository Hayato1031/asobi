<div class="doc">
<aside class="side">
  <nav aria-labelledby="toc-title" data-spy>
    <h2 id="toc-title" class="label"><%= ui(:contents) %></h2>
    <ol class="toc">
<%- content.guide.each_with_index do |ch, n| -%>
      <li><a href="#<%= h(ch["id"]) %>"><span class="num"><%= format("%02d", n + 1) %></span><%= h(t(ch["title"])) %></a></li>
<%- end -%>
    </ol>
  </nav>
</aside>
<div class="doc-body">
  <header class="doc-head">
    <p class="label"><%= ui(:chapters_count, content.guide.size) %></p>
    <h1><%= ui(:guide) %></h1>
    <p class="lead"><%= ui(:guide_lead) %></p>
  </header>
<%- content.guide.each_with_index do |ch, n| -%>
  <section class="chapter" id="<%= h(ch["id"]) %>" aria-labelledby="<%= h(ch["id"]) %>-title" data-spy-target>
    <p class="label"><span class="n"><%= format("%02d", n + 1) %></span> / <%= format("%02d", content.guide.size) %></p>
    <h2 id="<%= h(ch["id"]) %>-title"><%= inline(t(ch["title"])) %></h2>
<%- ch["steps"].each do |step| -%>
    <div class="step">
      <%= rich(t(step["text"])) %>
<%- if step["code"] -%>
      <%= example(step["code"], t(ch["title"])) %>
<%- end -%>
<%- unless step["words"].empty? -%>
      <p class="step-words"><span><%= ui(:in_this_step) %></span>
<%- step["words"].each do |w| -%>
        <a href="<%= h(word_href(w)) %>"><code><%= h(w) %></code></a>
<%- end -%>
      </p>
<%- end -%>
    </div>
<%- end -%>
  </section>
<%- end -%>
  <section class="doc-next" aria-labelledby="doc-next-title">
    <h2 id="doc-next-title"><%= ui(:next_steps) %></h2>
    <div class="cta">
      <a class="btn primary" href="<%= href('examples') %>"><%= ui(:examples) %> →</a>
      <a class="btn" href="<%= href('reference') %>"><%= ui(:reference) %></a>
      <a class="btn" href="<%= href('playground') %>"><%= ui(:playground) %></a>
    </div>
  </section>
</div>
</div>

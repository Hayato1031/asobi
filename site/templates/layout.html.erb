<!doctype html>
<html lang="<%= lang %>" data-root="<%= root %>" data-page="<%= page %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="dark">
<meta name="theme-color" content="#0b0b0f">
<title><%= h(title) %></title>
<meta name="description" content="<%= h(meta_description) %>">
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
<link rel="icon" href="<%= root %>assets/favicon.svg" type="image/svg+xml">
<link rel="canonical" href="<%= h(AsobiSite.page_url(page, lang)) %>">
<%- LANGUAGES.each_key do |code| -%>
<link rel="alternate" hreflang="<%= code %>" href="<%= h(AsobiSite.page_url(page, code)) %>">
<%- end -%>
<link rel="alternate" hreflang="x-default" href="<%= h(AsobiSite.page_url(page, :en)) %>">
<link rel="alternate" type="text/markdown" href="<%= h(page) %>.md">
<link rel="alternate" type="text/markdown" title="llms.txt" href="<%= root %>llms.txt">
<link rel="alternate" type="text/markdown" title="llms-full.txt" href="<%= root %>llms-full.txt">
<link rel="api-catalog" type="application/linkset+json" href="<%= root %>.well-known/api-catalog">
<link rel="agent-skills" type="application/json" href="<%= root %>.well-known/agent-skills/index.json">
<link rel="service-doc" href="<%= href("reference") %>">
<meta property="og:type" content="<%= og_type %>">
<meta property="og:site_name" content="asobi">
<meta property="og:title" content="<%= h(title) %>">
<meta property="og:description" content="<%= h(meta_description) %>">
<meta property="og:url" content="<%= h(AsobiSite.page_url(page, lang)) %>">
<meta property="og:locale" content="<%= og_locale %>">
<meta property="og:locale:alternate" content="<%= og_locale_alternate %>">
<meta property="og:image" content="<%= h(OG_IMAGE_URL) %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="asobi — Object to Art. Art to Object.">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="<%= h(title) %>">
<meta name="twitter:description" content="<%= h(meta_description) %>">
<meta name="twitter:image" content="<%= h(OG_IMAGE_URL) %>">
<script type="application/ld+json"><%= structured_data %></script>
<link rel="stylesheet" href="<%= root %>assets/site.css">
<script src="<%= root %>assets/player.js" defer></script>
<script src="<%= root %>assets/site.js" defer></script>
</head>
<body class="page-<%= page %><%= " sheet" unless page == "index" %>">
<a class="skip" href="#main"><%= ui(:skip) %></a>
<header class="top">
  <a class="brand" href="<%= href("index") %>"<%= ' aria-current="page"' if page == "index" %>><img src="<%= root %>assets/favicon.svg" alt="" width="18" height="20">asobi</a>
  <nav class="nav" aria-label="<%= ui(:menu) %>">
    <ul>
<%- NAV.each do |p| -%>
      <li><a href="<%= href(p) %>"<%= ' aria-current="page"' if page == p %>><%= ui(p.to_sym) %></a></li>
<%- end -%>
    </ul>
  </nav>
  <nav class="lang" aria-label="<%= ui(:language) %>">
<%- LANGUAGES.each do |code, name| -%>
<%- if code == lang -%>
    <span lang="<%= code %>" aria-current="true"><span aria-hidden="true"><%= code.upcase %></span><span class="visually-hidden"><%= name %></span></span>
<%- else -%>
    <a lang="<%= code %>" hreflang="<%= code %>" href="<%= h(other_language_href) %>" aria-label="<%= name %>" data-keep-hash><%= code.upcase %></a>
<%- end -%>
<%- end -%>
  </nav>
</header>
<main id="main">
<%= body %>
</main>
<footer class="foot">
  <a class="foot-brand" href="<%= href("index") %>" aria-label="asobi · <%= h(ui(:index)) %>">asobi</a>
  <p class="foot-meta"><a href="<%= href("index", "contribute") %>"><%= ui(:contribute) %></a> · <a href="<%= GITHUB_URL %>">GitHub</a> · <a href="<%= RUBYGEMS_URL %>">RubyGems</a> · <a href="<%= root %>llms.txt">llms.txt</a> · v<%= Asobi::VERSION %> · <%= h(ui(:footer_license)) %></p>
<%- if page == "playground" -%>
  <p class="foot-note"><%= h(ui(:footer_playground)) %></p>
<%- end -%>
</footer>
</body>
</html>
